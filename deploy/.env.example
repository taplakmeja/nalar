# Copy to .env (same directory) and adjust before `docker compose up`.
# Never commit the real .env file.

POSTGRES_DB=psikotes
POSTGRES_USER=psikotes
POSTGRES_PASSWORD=change-me-strong-password

JWT_ISSUER=Psikotes.Api
JWT_AUDIENCE=Psikotes.Web
# Generate with: openssl rand -base64 48
JWT_KEY=change-me-at-least-32-characters-long-secret!!

FRONTEND_URL=http://localhost:8080
FRONTEND_PORT=8080

# Initial administrator account (created on first API startup)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-too
